# Copy to .env and fill in: cp .env.example .env
# .env is ignored by git, and the lab reads it on start.

# Required for the model presets in configs/models.yaml (provider "openai").
OPENAI_API_KEY=

# Your exact Minecraft name (several: Name1,Name2). Only owners can give the bots tasks. This replaces owners in
# configs/lab.yaml, so your name stays out of git.
MCLAB_OWNERS=

# Optional. The lab finds the Java 21 that the Minecraft Launcher installed; set this to use another one.
# JAVA_HOME=

# Optional, for npm run test:integration only (it starts a throwaway 1.21.11 server):
# MCLAB_ACCEPT_EULA=1            you accept the Minecraft EULA (https://aka.ms/MinecraftEULA) for that server
# MCLAB_LIVE_MODEL=gpt-6-luna    also run one real turn per harness with this model preset (uses your key)
# MCLAB_SERVER_JAR=              a server.jar to use instead of downloading one
